{
	"title": "Inside the house",
	"size": [6, 7],
	"start": [2, 4],
	"mood_from": "village",
	"music": "res://assets/music/room_theme.mp3",
	"ground_image": {
		"path": "res://assets/worlds/house_inside_ground.png",
		"scale": 1.567,
		"origin": [-490.1, -238.78]
	},
	"ground": [
		"      ",
		" ____ ",
		" ____ ",
		" ____ ",
		" ____ ",
		"  _   ",
		"      "
	],
	"objects": [
		{"id": "old_man", "kind": "old_man", "cell": [3, 1]},
		{"id": "cupboard", "kind": "cupboard", "cell": [1, 2], "access": [[2, 2]]},
		{"id": "table", "kind": "table", "cell": [4, 3], "state": "notebook"}
	],
	"rules": [
		{
			"on": "interact", "object": "old_man",
			"if": [{"fact": "met_old_man", "is": false}],
			"do": [{"say": "old_man.first", "who": "old_man"}, {"set": "met_old_man"}, {"note": "old_man"}]
		},
		{
			"on": "interact", "object": "old_man",
			"if": [{"item": "notebook", "is": false}],
			"do": [{"say": "old_man.take_it", "who": "old_man"}]
		},
		{
			"on": "interact", "object": "old_man",
			"if": [{"fixed": "brook", "world": "village"}, {"fixed": "wind", "world": "village"}],
			"do": [{"say": "old_man.whole", "who": "old_man"}]
		},
		{
			"on": "interact", "object": "old_man",
			"if": [{"fact": "crank_known"}, {"fact": "crank_taken", "is": false}],
			"do": [{"say": "old_man.crank", "who": "old_man"}]
		},
		{
			"on": "interact", "object": "old_man",
			"if": [{"fixed": "wind", "world": "village"}],
			"do": [{"say": "old_man.hint_brook", "who": "old_man"}]
		},
		{
			"on": "interact", "object": "cupboard",
			"if": [{"fact": "crank_known"}, {"fact": "crank_taken", "is": false}],
			"do": [{"give": "crank"}, {"set": "crank_taken"}, {"say": "cupboard.crank"}]
		},
		{
			"on": "interact", "object": "table",
			"if": [{"fact": "met_old_man"}, {"object": "table", "state": "notebook"}],
			"do": [{"change": "table", "state": ""}, {"give": "notebook"}, {"say": "notebook.taken"}]
		},
		{
			"on": "interact", "object": "old_man",
			"do": [{"say": "old_man.hint_wind", "who": "old_man"}]
		},
		{
			"on": "enter", "cells": [[2, 5]],
			"do": [{"go": "village", "cell": [4, 7]}]
		}
	]
}
